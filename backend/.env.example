# Database
DATABASE_URL=postgresql://user:password@host:5432/lodale

# Server
PORT=5000
NODE_ENV=production

# Security (REQUIRED in production – must be at least 32 characters)
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# CORS – comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Uploads (temporary – will be replaced by cloud storage)
UPLOADS_DIR=./uploads

# Admin seed credentials (only used on first run if no admin exists)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_strong_password

# Cloudinary (recommended for production – leave empty to use local disk in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend – leave empty to log emails to console in development)
RESEND_API_KEY=
EMAIL_FROM=Lodale <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_CALLBACK_URL=http://localhost:5173/dashboard/tenant

