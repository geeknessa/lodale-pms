{
  "name": "lodale-backend",
  "version": "1.0.0",
  "description": "Express REST API backend server for Lodale PMS",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:scripts": "node tests/autoApproval.test.js && node tests/autoApprovalDelay.test.js && node tests/e2eApiAutoApproval.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "resend": "^6.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "qs": "^6.16.0",
    "chokidar": "^4.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "autoApproval\\.test\\.js$",
      "autoApprovalDelay\\.test\\.js$",
      "e2eApiAutoApproval\\.test\\.js$"
    ]
  }
}
